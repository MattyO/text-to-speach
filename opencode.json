{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "mcp": {
    "servers": {
      "claude-context": {
        "type": "local",
        "command": ["npx", "-y", "@zilliz/claude-context-mcp@latest"],
        "cwd": ".",
        "environment": {
          "EMBEDDING_MODEL": "Qwen3-Embedding-0.6B-Q8_0.gguf",
          "OPENAI_BASE_URL":"http://127.0.0.1:9931/v1",
          "OPENAI_API_KEY":"not-needed",
          "MILVUS_ADDRESS":"http://localhost:19530",
          "MILVUS_TOKEN":"locallocal",
          "EMBEDDING_BATCH_SIZE":"100",
          "CUSTOM_IGNORE_PATTERNS":"volumes,env"

        }
      }
    }
  }

}
